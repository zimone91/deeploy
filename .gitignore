# ============================================================================
# DeePloy .gitignore — keep the public repo clean of secrets and host state.
# The private build overlay lives under private/ and is NEVER committed.
# ============================================================================

# Private build overlay (optional custom patches + their threshold) — the only
# path by which a non-vanilla build is produced. Excluded so it cannot leak.
# The threshold file is blocked ANYWHERE in the tree (not only under private/):
# toolchain_write_threshold also copies it to $SOLANA_HOME, and a stray copy in
# a checkout must never be committable. (P13)
private/
*.patch
**/mostly_confirmed_threshold

# Real configs and key material (only the .example is tracked)
deeploy.conf
*.conf
!deeploy.conf.example
*-keypair.json
unstaked-identity.json
id.json
dz-keypair*.json
keys/

# Runtime state / backups / logs (also live under /opt/deeploy at runtime)
state/
backups/
logs/
*.log

# Cloudflare Worker tooling. `npx wrangler deploy` is run from the repo root and
# writes its state and bundles next to wrangler.toml; none of it belongs in the
# tree, and the deploy step should not leave the working copy dirty.
.wrangler/
node_modules/

# Editor / OS noise
*.swp
.DS_Store
